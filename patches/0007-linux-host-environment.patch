diff --git a/apps/desktop-host/src/node-environment.ts b/apps/desktop-host/src/node-environment.ts
new file mode 100644
index 00000000..ab60437f
--- /dev/null
+++ b/apps/desktop-host/src/node-environment.ts
@@ -0,0 +1,25 @@
+/** Publish the Desktop resource root and launch the package manager with the current Node runtime. */
+import { delimiter } from 'node:path'
+
+/** Expose the launcher-supplied resource root to plugins running under standalone Node. */
+export function exposeDesktopResourcesPath(): void {
+  const resources = process.env.DSH_DESKTOP_RESOURCES_PATH
+  if (process.versions.electron !== undefined || !resources) return
+  const desktopProcess: NodeJS.Process & { resourcesPath?: string } = process
+  desktopProcess.resourcesPath ??= resources
+}
+
+/**
+ * Configure the bundled package manager and the Node launcher used by its package scripts.
+ * @param bin - Directory of the Desktop Node launcher.
+ * @returns Overrides for the package manager's child environment.
+ */
+export function desktopPackageManagerEnvironment(bin: string): Readonly<Record<string, string>> {
+  const electron = process.versions.electron !== undefined
+  return {
+    ...(electron ? { ELECTRON_RUN_AS_NODE: '1' } : {}),
+    DSH_DESKTOP_NODE_ELECTRON: electron ? '1' : '0',
+    DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+    PATH: `${bin}${delimiter}${process.env.PATH ?? ''}`,
+  }
+}
