diff --git a/apps/desktop/src/caption-controls.ts b/apps/desktop/src/caption-controls.ts
new file mode 100644
index 00000000..8ccb7490
--- /dev/null
+++ b/apps/desktop/src/caption-controls.ts
@@ -0,0 +1,109 @@
+/** Linux caption window controls drawn in the renderer instead of Chromium's compact overlay. */
+
+import { ipcRenderer } from 'electron'
+import { DESKTOP_IPC } from './ipc.ts'
+import { resolveDesktopLocale } from './locale.ts'
+
+type WindowAction = 'minimize' | 'toggle-maximize' | 'close'
+
+const ICONS = {
+  minimize: '<line x1="0" y1="5.5" x2="10" y2="5.5"/>',
+  maximize: '<rect x="0.5" y="0.5" width="9" height="9"/>',
+  restore: '<path d="M2.5 0.5H9.5V7.5"/><path d="M0.5 2.5H7.5V9.5H0.5Z"/>',
+  close: '<line x1="0.5" y1="0.5" x2="9.5" y2="9.5"/><line x1="9.5" y1="0.5" x2="0.5" y2="9.5"/>',
+} as const
+
+function icon(name: keyof typeof ICONS): string {
+  return `<svg viewBox="0 0 10 10" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1">${ICONS[name]}</svg>`
+}
+
+/**
+ * Mount the caption buttons at the window's top-right edge. The renderer owns
+ * their size and spacing so Linux matches the Windows caption; the main process
+ * still owns the window actions and the current maximized state.
+ */
+export function installLinuxCaptionControls(): void {
+  if (process.platform !== 'linux') return
+
+  const host = document.createElement('div')
+  host.dataset.linuxCaptionControls = ''
+  const shadow = host.attachShadow({ mode: 'open' })
+  const style = document.createElement('style')
+  style.textContent = `
+    :host {
+      position: fixed; top: 0; right: 0; z-index: 1100;
+      height: var(--dsh-windows-titlebar-height, 40px);
+      display: flex; flex-direction: row;
+      -webkit-app-region: no-drag;
+    }
+    :host-context(html[data-fullscreen]) { display: none; }
+    button {
+      width: 46px; height: 100%; margin: 0; padding: 0; border: 0;
+      display: grid; place-items: center;
+      background: transparent; color: var(--dsw-alias-label-secondary);
+      cursor: default; -webkit-app-region: no-drag;
+    }
+    button:hover { background: var(--dsw-alias-interactive-bg-hover); color: var(--dsw-alias-label-primary); }
+    button[data-close]:hover { background: #c42b1c; color: #ffffff; }
+    button:focus-visible { outline: 2px solid var(--dsw-alias-state-business-primary); outline-offset: -2px; }
+    :host-context(html[data-input-modality='pointer']) button:focus-visible { outline-color: transparent; }
+    svg { display: block; }
+  `
+
+  const send = (action: WindowAction): void => {
+    void ipcRenderer.invoke(DESKTOP_IPC.windowControl, action).catch(() => {})
+  }
+  const createButton = (action: WindowAction): HTMLButtonElement => {
+    const button = document.createElement('button')
+    button.type = 'button'
+    button.addEventListener('click', () => { send(action) })
+    return button
+  }
+
+  const minimize = createButton('minimize')
+  const maximize = createButton('toggle-maximize')
+  const close = createButton('close')
+  close.dataset.close = ''
+  minimize.innerHTML = icon('minimize')
+  maximize.innerHTML = icon('maximize')
+  close.innerHTML = icon('close')
+
+  let maximized = false
+  const updateLabels = (): void => {
+    // A sandboxed preload can run before the HTML parser creates the document root.
+    const root = document.documentElement as HTMLElement | null
+    const { messages } = resolveDesktopLocale(root?.lang ?? '')
+    minimize.title = minimize.ariaLabel = messages.windowMinimize
+    maximize.title = maximize.ariaLabel = maximized ? messages.windowRestore : messages.windowMaximize
+    close.title = close.ariaLabel = messages.windowClose
+  }
+  const applyMaximized = (next: boolean): void => {
+    if (next === maximized) return
+    maximized = next
+    maximize.innerHTML = icon(next ? 'restore' : 'maximize')
+    updateLabels()
+  }
+
+  ipcRenderer.on(DESKTOP_IPC.windowMaximized, (_event, next: unknown) => {
+    if (typeof next === 'boolean') applyMaximized(next)
+  })
+
+  shadow.append(style, minimize, maximize, close)
+  let language: MutationObserver | undefined
+  const install = (): void => {
+    updateLabels()
+    const root = document.documentElement as HTMLElement | null
+    if (root !== null) {
+      language = new MutationObserver(updateLabels)
+      language.observe(root, { attributes: true, attributeFilter: ['lang'] })
+    }
+    document.body?.append(host)
+  }
+  if (document.readyState === 'loading') window.addEventListener('DOMContentLoaded', install, { once: true })
+  else install()
+
+  window.addEventListener('pagehide', () => {
+    language?.disconnect()
+    host.remove()
+  }, { once: true })
+}
