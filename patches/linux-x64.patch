new file mode 100644
index 00000000..1772edc4
--- /dev/null
+++ b/apps/desktop/tests/caption-controls.client.spec.ts
@@ -0,0 +1,41 @@
+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import { DESKTOP_IPC } from '../src/ipc.ts'
+import { installLinuxCaptionControls } from '../src/caption-controls.ts'
+
+const { on, invoke } = vi.hoisted(() => ({ on: vi.fn(), invoke: vi.fn(async () => undefined) }))
+vi.mock('electron', () => ({ ipcRenderer: { on, invoke } }))
+
+afterEach(() => {
+  document.querySelector('[data-linux-caption-controls]')?.remove()
+  on.mockClear()
+  invoke.mockClear()
+  vi.restoreAllMocks()
+})
+
+it('mounts before the document root exists', () => {
+  vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+  const earlyDocument: { readonly documentElement: HTMLElement | null } = document
+  vi.spyOn(earlyDocument, 'documentElement', 'get').mockReturnValue(null)
+  expect(() => installLinuxCaptionControls()).not.toThrow()
+  expect(document.querySelector('[data-linux-caption-controls]')).not.toBeNull()
+})
+
+it('invokes the window actions and swaps the maximize glyph', () => {
+  vi.spyOn(process, 'platform', 'get').mockReturnValue('linux')
+  installLinuxCaptionControls()
+  const host = document.querySelector<HTMLElement>('[data-linux-caption-controls]')!
+  const buttons = [...host.shadowRoot!.querySelectorAll('button')]
+  for (const button of buttons) button.click()
+  expect(invoke.mock.calls).toEqual([
+    [DESKTOP_IPC.windowControl, 'minimize'],
+    [DESKTOP_IPC.windowControl, 'toggle-maximize'],
+    [DESKTOP_IPC.windowControl, 'close'],
+  ])
+  const handler = on.mock.calls.find(([channel]) => channel === DESKTOP_IPC.windowMaximized)![1] as
+    (event: unknown, maximized: boolean) => void
+  handler({}, true)
+  expect(buttons[1]!.innerHTML).toContain('M2.5 0.5H9.5V7.5')
+  handler({}, false)
+  expect(buttons[1]!.innerHTML).toContain('width="9" height="9"')
+})
