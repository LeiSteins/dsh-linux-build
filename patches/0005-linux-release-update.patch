index 00000000..c200d259
--- /dev/null
+++ b/apps/desktop/tests/linux-release-update.spec.ts
@@ -0,0 +1,182 @@
+import { expect, it, vi } from 'vitest'
+import { checkLinuxReleaseUpdate } from '../src/linux-release-update.ts'
+
+const repository = 'test-owner/test-linux-build'
+const updateConfig = 'provider: github\nowner: test-owner\nrepo: test-linux-build\n'
+const signal = new AbortController().signal
+const mirror = 'https://mirror.example/'
+const releasesApi = `https://api.github.com/repos/${repository}/releases?per_page=100&page=1`
+
+function downloadUrl(version: string, suffix: string): string {
+  return `https://github.com/${repository}/releases/download/dsh-v${version}/dsh-linux-${version}-${suffix}`
+}
+
+function release(version: string, draft = false) {
+  return {
+    draft, tag_name: `dsh-v${version}`,
+    prerelease: version.includes('-'),
+    assets: [
+      `dsh-linux-${version}-amd64.deb`, `dsh-linux-${version}-x86_64.rpm`,
+      `dsh-linux-${version}-x86_64.AppImage`, 'SHA256SUMS',
+    ].map(name => ({ name, state: 'uploaded', size: 1 })),
+  }
+}
+
+it.each([
