diff --git a/apps/desktop/src/linux-release-update.ts b/apps/desktop/src/linux-release-update.ts
new file mode 100644
index 00000000..acb92f4e
--- /dev/null
+++ b/apps/desktop/src/linux-release-update.ts
@@ -0,0 +1,217 @@
+/** Read the public DSH Linux release list for user-initiated update checks. */
+
+import { compare, valid } from 'semver'
+import { load } from 'js-yaml'
+
+const installerSuffixesByArch = {
+  x64: { deb: 'amd64.deb', rpm: 'x86_64.rpm', appimage: 'x86_64.AppImage', pacman: 'x86_64.pkg.tar.zst' },
+  arm64: { deb: 'arm64.deb', rpm: 'aarch64.rpm', appimage: 'arm64.AppImage', pacman: 'aarch64.pkg.tar.zst' },
+} as const
+
+type ReleaseUnavailable = { readonly kind: 'current' | 'incomplete' | 'network-error' | 'service-error' }
+
+/** Result of reading community releases, including preview releases. */
+export type LinuxReleaseUpdate =
+  | {
+    readonly kind: 'available'
+    readonly version: string
+    readonly url: string
+    readonly installer?: string
+    readonly mirrorUrl?: string
+  }
+  | ReleaseUnavailable
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function githubRepository(appUpdateConfig: string): string {
+  const config: unknown = load(appUpdateConfig)
+  if (!isRecord(config) || config.provider !== 'github'
+    || (config.host !== undefined && config.host !== 'github.com')
+    || (config.protocol !== undefined && config.protocol !== 'https')
+    || (config.private !== undefined && config.private !== false)
+    || typeof config.owner !== 'string' || !/^[A-Za-z0-9-]+$/u.test(config.owner)
+    || typeof config.repo !== 'string' || !/^[A-Za-z0-9_.-]+$/u.test(config.repo)
+    || config.repo === '.' || config.repo === '..') {
+    throw new Error('Linux app-update.yml must configure a public GitHub repository')
+  }
+  return `${config.owner}/${config.repo}`
+}
+
+function installerName(version: string, suffix: string): string {
+  return `dsh-linux-${version}-${suffix}`
+}
+
+function uploadedAssets(assets: unknown): Map<string, number> {
+  const uploaded = new Map<string, number>()
+  if (!Array.isArray(assets)) return uploaded
+  for (const asset of assets) {
+    if (isRecord(asset) && typeof asset.name === 'string' && asset.state === 'uploaded'
+      && typeof asset.size === 'number' && asset.size > 0) uploaded.set(asset.name, asset.size)
+  }
+  return uploaded
+}
+
+function mirrorPrefix(value: string | undefined): string | undefined {
+  if (!value?.trim()) return undefined
+  const url = URL.parse(value.trim())
+  if (url === null || url.protocol !== 'https:' || url.username || url.password
+    || url.href.includes('?') || url.href.includes('#')) {
+    console.warn('Linux update check: ignoring invalid DSH_LINUX_UPDATE_MIRROR')
+    return undefined
+  }
+  return url.href.replace(/\/*$/u, '/')
+}
+
+type ReleaseRequest = (url: string, init: RequestInit) => Promise<Response>
+type LinuxVersion = { readonly upstream: string; readonly revision: bigint }
+type ReleaseCandidate = {
+  readonly kind: 'available'
+  readonly version: string
+  readonly order: LinuxVersion
+  readonly installerSize: number | undefined
+}
+
+function parseLinuxVersion(version: string): LinuxVersion | undefined {
+  if (valid(version) !== version) return undefined
+  const [, upstream = '', revision] = /^(.*)-([0-9]+)$/u.exec(version) ?? []
+  // Published versions without a Linux revision precede numbered builds of the same upstream version.
+  if (revision === undefined || valid(upstream) !== upstream) return { upstream: version, revision: 0n }
+  if (revision.startsWith('0')) return undefined
+  return { upstream, revision: BigInt(revision) }
+}
+
+function isNewerVersion(candidate: LinuxVersion, current: LinuxVersion): boolean {
+  const upstreamOrder = compare(candidate.upstream, current.upstream)
+  return upstreamOrder > 0 || (upstreamOrder === 0 && candidate.revision > current.revision)
+}
+
+async function findLinuxRelease(
+  releasesApi: string,
+  currentVersion: LinuxVersion,
+  requiredSuffixes: readonly string[],
+  suffix: string | undefined,
+  request: ReleaseRequest,
+  signal: AbortSignal,
+  timeout: number,
+): Promise<ReleaseCandidate | ReleaseUnavailable> {
+  const deadline = AbortSignal.any([signal, AbortSignal.timeout(timeout)])
+  let best: ReleaseCandidate | undefined
+  let incomplete = false
+  for (let page = 1; ; page++) {
+    let response: Response
+    try {
+      response = await request(`${releasesApi}?per_page=100&page=${page}`, {
+        headers: { Accept: 'application/vnd.github+json' },
+        cache: 'no-store',
+        credentials: 'omit',
+        redirect: 'error',
+        signal: deadline,
+      })
+    } catch (error) {
+      signal.throwIfAborted()
+      console.warn('Linux update check: could not reach the release API', error)
+      return { kind: 'network-error' }
+    }
+    if (!response.ok) {
+      console.warn('Linux update check: release API returned HTTP', response.status)
+      return { kind: 'service-error' }
+    }
+    let releases: unknown
+    try {
+      releases = await response.json()
+    } catch (error) {
+      signal.throwIfAborted()
+      console.warn('Linux update check: could not read the release list', error)
+      return { kind: deadline.aborted ? 'network-error' : 'service-error' }
+    }
+    if (!Array.isArray(releases)) return { kind: 'service-error' }
+    for (const release of releases) {
+      if (!isRecord(release) || release.draft !== false || typeof release.tag_name !== 'string'
+        || !release.tag_name.startsWith('dsh-v')) continue
+      const version = release.tag_name.slice('dsh-v'.length)
+      const order = parseLinuxVersion(version)
+      if (order === undefined || !isNewerVersion(order, currentVersion)) continue
+      const assets = uploadedAssets(release.assets)
+      if (!assets.has('SHA256SUMS') || !requiredSuffixes.every(required => assets.has(installerName(version, required)))) {
+        incomplete = true
+      } else if (best === undefined || isNewerVersion(order, best.order)) {
+        const installerSize = suffix === undefined ? undefined : assets.get(installerName(version, suffix))
+        best = { kind: 'available', version, order, installerSize }
+      }
+    }
+    // Follow pagination without trusting a response-supplied URL.
+    if (!/(?:^|,)\s*<[^>]+>;\s*rel="next"/u.test(response.headers.get('link') ?? '')) break
+  }
+  signal.throwIfAborted()
+  return best ?? { kind: incomplete ? 'incomplete' : 'current' }
+}
+
+/**
+ * Find the newest complete community release by version across all pages.
+ * @param appUpdateConfig - Bundled electron-builder app-update.yml content.
+ * @param currentVersion - Version of the running application.
+ * @param arch - Architecture of the running Linux application.
+ * @param packageType - Installer format recorded by the Linux build.
+ * @param request - Main-process HTTPS transport.
+ * @param signal - Cancels the check when the prompt closes or the app quits.
+ * @param mirror - Optional HTTPS proxy prefix for public GitHub URLs.
+ * @returns The matching installer or release page, or the reason an update is unavailable.
+ */
+export async function checkLinuxReleaseUpdate(
+  appUpdateConfig: string,
+  currentVersion: string,
+  arch: string,
+  packageType: string | undefined,
+  request: ReleaseRequest,
+  signal: AbortSignal,
+  mirror?: string,
+): Promise<LinuxReleaseUpdate> {
+  signal.throwIfAborted()
+  const current = parseLinuxVersion(currentVersion)
+  if (current === undefined || (arch !== 'x64' && arch !== 'arm64')) return { kind: 'service-error' }
+  const repository = githubRepository(appUpdateConfig)
+  const releasesApi = `https://api.github.com/repos/${repository}/releases`
+  const releasesPage = `https://github.com/${repository}/releases`
+  const prefix = mirrorPrefix(mirror)
+  const installers = Object.entries(installerSuffixesByArch[arch])
+  const suffix = installers.find(([type]) => type === packageType)?.[1]
+  // Older releases can still update installers that existed before Arch support.
+  const requiredSuffixes = installers.filter(([type]) => type !== 'pacman' || packageType === 'pacman').map(([, name]) => name)
+  let release = prefix === undefined ? undefined
+    : await findLinuxRelease(prefix + releasesApi, current, requiredSuffixes, suffix, request, signal, 6_000)
+  signal.throwIfAborted()
+  if (release === undefined || release.kind === 'network-error' || release.kind === 'service-error') {
+    release = await findLinuxRelease(releasesApi, current, requiredSuffixes, suffix, request, signal, 15_000)
+  }
+  if (release.kind !== 'available') return release
+  const { version, installerSize } = release
+  const tag = `dsh-v${version}`
+  if (suffix === undefined) return { kind: 'available', version, url: `${releasesPage}/tag/${tag}` }
+
+  const installer = installerName(version, suffix)
+  const url = `${releasesPage}/download/${tag}/${installer}`
+  const official = { kind: 'available', version, installer, url } as const
+  if (prefix === undefined || installerSize === undefined) return official
+
+  const mirrorUrl = prefix + url
+  try {
+    const response = await request(mirrorUrl, {
+      method: 'HEAD',
+      cache: 'no-store',
+      credentials: 'omit',
+      redirect: 'error',
+      signal: AbortSignal.any([signal, AbortSignal.timeout(5_000)]),
+    })
+    signal.throwIfAborted()
+    if (response.status === 200 && Number(response.headers.get('content-length')) === installerSize
+      && !response.headers.get('content-type')?.startsWith('text/html')) {
+      return { ...official, mirrorUrl }
+    }
+  } catch (error) {
+    signal.throwIfAborted()
+    console.warn('Linux update check: could not reach the installer mirror', error)
+  }
+  return official
+}
