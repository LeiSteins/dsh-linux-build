+/**
+ * Select the public environment used by a repository build and its packer.
+ * @param root - Checkout supplying version and Git metadata.
+ * @param environment - Parent environment, including the community Linux build's explicit title.
+ * @param profile - Build profile, defaulting to the parent's selector.
+ * @returns The selected public values recorded with the client artifacts.
+ */
+export function resolveRepositoryClientBuildEnvironment(
+  root: string,
+  environment: NodeJS.ProcessEnv,
+  profile: string | undefined = environment[CLIENT_BUILD_PROFILE_SELECTOR],
+): ClientBuildEnvironment {
+  const values = resolveClientBuildEnvironment(repositoryClientBuildEnvironment(root, environment), profile)
+  const title = environment.DSH_DESKTOP_LINUX_CLIENT_TITLE
+  return profile === 'local' && title !== undefined ? { ...values, DSH_CLIENT_TITLE: title } : values
+}
